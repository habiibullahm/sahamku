# Salin ke .env dan isi. JANGAN commit .env
TELEGRAM_BOT_TOKEN=
# LLM untuk /ask: "groq" (free tier) atau "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# chat_id admin (angka) untuk menerima laporan terjadwal & alert error
ADMIN_CHAT_ID=
# Opsional: channel publik untuk broadcast laporan (bot harus admin dengan izin post)
CHANNEL_ID=@sahamku_daily
DB_PATH=sahamku.db
# Opsional: override jadwal untuk testing, format "HH:MM" per job
# SCHEDULE_OVERRIDE_AFTERMARKET=17:00
# SCHEDULE_OVERRIDE_PREMARKET=08:15
# Universe saham: lq45 | idx80 | liquid (master IDX diimpor dengan update_universe.py)
UNIVERSE=liquid
UNIVERSE_MIN_COVERAGE=0.90
LIQUIDITY_MIN_HISTORY=200
LIQUIDITY_MIN_TRADED_20=18
LIQUIDITY_MIN_TRADED_60=50
LIQUIDITY_MIN_VALUE_20=5000000000
LIQUIDITY_MIN_VALUE_60=3000000000
LIQUIDITY_MIN_CLOSE=50
POTENTIAL_GROWTH_MIN_SCORE=60
# Opsional: endpoint HTTPS resmi IDX yang mengembalikan CSV/JSON disclosure.
# Jika kosong atau IDX menolak akses, gunakan scripts/import_idx_disclosures.py.
IDX_DISCLOSURE_URL=
IDX_DISCLOSURE_TIMEOUT_SECONDS=20
# Unduhan Yahoo EOD dibuat kecil/berjeda untuk mengurangi HTTP 429.
EOD_BATCH_SIZE=10
EOD_BATCH_DELAY_SECONDS=1.0
