# Salin ke .env dan isi. JANGAN commit .env
TELEGRAM_BOT_TOKEN=
# LLM untuk /ask: "groq" (free tier) atau "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# chat_id admin (angka) untuk menerima laporan terjadwal & alert error
ADMIN_CHAT_ID=
# Opsional: channel publik untuk broadcast laporan (bot harus admin dengan izin post)
CHANNEL_ID=@sahamku_id
DB_PATH=sahamku.db
# Opsional: override jadwal untuk testing, format "HH:MM" per job
# SCHEDULE_OVERRIDE_AFTERMARKET=17:00
# SCHEDULE_OVERRIDE_PREMARKET=08:15
